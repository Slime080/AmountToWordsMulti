@page
@model AmountToWordsMulti.TranslatorModel
@{
    ViewData["Title"] = "Number to Words Translator";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Required CSS -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <h2>💰 Number to Currency Words Translator</h2>

        <form method="post">
            <div class="form-group">
                <label class="form-label text-muted">Amount</label>
                <input type="number" id="number" name="Amount" class="form-control"
                       required step="0.01" placeholder="Enter amount (e.g., 1234.56)">
            </div>

            <div class="form-group mt-4">
                <label class="form-label text-muted">Language</label>
                <select id="language" name="Language" class="form-control" required>
                    <option value="fil">fil Tagalog</option>
                    <option value="en">🇺🇸 English</option>
                    <option value="fr">🇫🇷 French</option>
                    <option value="es">🇪🇸 Spanish</option>
                    <option value="de">🇩🇪 German</option>
                    <option value="it">🇮🇹 Italian</option>
                    <option value="pt">🇵🇹 Portuguese</option>
                    <option value="zh-Hans">🇨🇳 Chinese (Simplified)</option>
                    <option value="zh-Hant">🇨🇳 Chinese (Traditional)</option>
                    <option value="ja">🇯🇵 Japanese</option>
                    <option value="ko">🇰🇷 Korean</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-language icon"></i>Translate to Words
            </button>
        </form>

        @if (!string.IsNullOrEmpty(Model.Result))
        {
            <div class="result-card">
                <h5 class="mb-3 text-primary"><i class="fas fa-comment-dots"></i> Translation Result</h5>
                <div class="alert alert-success">
                    @Model.Result
                </div>

                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="alert alert-info">
                            <strong><i class="fas fa-hashtag"></i> Formatted:</strong> @Model.FormattedNumber
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="alert alert-warning">
                            <strong><i class="fas fa-globe"></i> Language:</strong> @Model.LanguageDisplay
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Required JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/scripts.js" asp-append-version="true"></script>
</body>
</html>